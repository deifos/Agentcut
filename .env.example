# Public URL of the deployed app (used for metadata / Open Graph).
NEXT_PUBLIC_APP_URL=https://agentcut.synteq.app

# Optional: base URL of a CDN that hosts the music library under /screenslick-music/<file>.
# Without it the music catalog tools are unavailable (generated music still works).
NEXT_PUBLIC_MUSIC_CDN_URL=

# Optional: base URL of the archival b-roll catalog (shots.json, vectors.f32, thumbs/, shots/), built by
# scripts/broll-index. Without it the b-roll tools are unavailable.
NEXT_PUBLIC_BROLL_CDN_URL=
# Optional: where the server keeps the b-roll search model (~110 MB, downloaded on first search). Default: OS temp.
# BROLL_MODEL_CACHE=
