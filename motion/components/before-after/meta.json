{
  "id": "before-after",
  "name": "Before / After",
  "category": "Talking Head",
  "durationInFrames": 120,
  "layer": "overlay",
  "description": "A number that changes: the old value is struck out, then the new one lands in the accent.",
  "useWhen": "Savings, speed-ups, prices: \"$240 → $0\", \"3 hours → 4 minutes\". Land the after value on the word that says it.",
  "tags": [
    "before after",
    "price",
    "number",
    "savings",
    "card",
    "talking head"
  ],
  "props": {
    "kicker": {
      "type": "text",
      "label": "Kicker",
      "default": "What it costs you"
    },
    "title": {
      "type": "text",
      "label": "Title",
      "default": "Per month"
    },
    "beforeLabel": {
      "type": "text",
      "label": "Before label",
      "default": "Before"
    },
    "before": {
      "type": "text",
      "label": "Before",
      "default": "$240"
    },
    "afterLabel": {
      "type": "text",
      "label": "After label",
      "default": "After"
    },
