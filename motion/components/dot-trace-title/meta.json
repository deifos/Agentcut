{
  "id": "dot-trace-title",
  "name": "Dot Trace Title",
  "category": "Text & Titles",
  "description": "A headline that looks generated by an agent: a scan line traces the letters in dots, the dots swell into the glyphs, and the real type resolves out of a blur.",
  "useWhen": "AI products, agents, 'built by AI', launches of generative features, the moment a product creates something; also a techy title card for dev tools. Two or three short words per line. Mark the accent word with *stars*.",
  "durationInFrames": 90,
  "layer": "overlay",
  "stillAt": 0.75,
  "tags": ["ai", "generate", "dots", "scan", "title", "agent", "tech", "halftone"],
  "props": {
    "lines": { "type": "lines", "label": "Headline", "default": ["Generated", "by *agents*"], "max": 3, "help": "One line per row. *Starred* words (or a *starred phrase*) use the accent." },
    "font": {
      "type": "select",
      "style": "font",
      "label": "Font",
      "default": "display",
      "options": [
        { "value": "display", "label": "Bricolage" },
        { "value": "sans", "label": "Inter" },
        { "value": "grotesk", "label": "Space Grotesk" },
        { "value": "wide", "label": "Unbounded" },
        { "value": "serif", "label": "Instrument Serif" },
        { "value": "mono", "label": "Geist Mono" },
        { "value": "condensed", "label": "Anton" }
      ]
    },
    "weight": {
      "type": "select",
      "style": "weight",
      "label": "Weight",
      "default": "800",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    "size": { "type": "number", "label": "Size", "default": 18, "min": 6, "max": 34, "step": 0.5, "unit": "% of frame", "help": "Type size: this share of the frame's short side, times 0.9 (18 is about 16% of the short side)." },
    "color": { "type": "color", "style": "text", "label": "Text", "default": "#ffffff" },
    "accent": { "type": "color", "style": "accent", "label": "Scan and accent", "default": "#7c5cff" },
    "background": { "type": "color", "label": "Background", "default": "transparent" },
    "dot": { "type": "number", "label": "Dot size", "default": 9, "min": 4, "max": 24, "step": 1, "unit": "px", "help": "Dot spacing in px at 1080p on the short side; it scales with the frame size." },
    "build": { "type": "number", "label": "Build time", "default": 1.8, "min": 0.6, "max": 5, "step": 0.1, "unit": "s" }
  },
  "examples": [
    { "name": "Generated", "props": {} },
    { "name": "On paper", "props": { "lines": ["Your site,", "*built*"], "color": "#111111", "accent": "#f97316", "background": "#f5f3ee", "font": "grotesk" } },
    { "name": "Mono", "props": { "lines": ["npx agentcut"], "font": "mono", "weight": "700", "accent": "#22d3ee", "size": 12 } }
  ]
}
