{
  "id": "halftone-wave",
  "name": "Halftone Wave",
  "category": "Backgrounds",
  "description": "A halftone dot matrix that breathes: dot sizes follow moving waves, ripples from the center or drifting noise, with an optional color blend and a soft glow.",
  "useWhen": "A graphic, print-inspired backdrop behind titles, stats or a floating product shot: tech launches, music or event promos, section cards. Keep text on top bold; use \"noise\" for calm, \"ripple\" for energy.",
  "durationInFrames": 150,
  "layer": "full",
  "tags": ["background", "halftone", "dots", "dot matrix", "wave", "ripple", "pattern", "retro", "print"],
  "props": {
    "mode": { "type": "select", "label": "Motion", "default": "wave", "options": [{ "value": "wave", "label": "Waves" }, { "value": "ripple", "label": "Ripple" }, { "value": "noise", "label": "Noise" }] },
    "background": { "type": "color", "label": "Background", "default": "#09090b" },
    "dotColor": { "type": "color", "label": "Dots", "default": "#f4f4f5" },
    "gradient": { "type": "boolean", "label": "Blend to a second color", "default": true },
    "secondColor": { "type": "color", "label": "Second color", "default": "#22d3ee", "help": "The dots blend into it toward the bottom right." },
    "accent": { "type": "color", "label": "Glow", "default": "#6366f1" },
    "density": { "type": "number", "label": "Density", "default": 36, "min": 12, "max": 60, "step": 1, "unit": "dots", "help": "Dots across the short side." },
    "dotSize": { "type": "number", "label": "Dot size", "default": 90, "min": 30, "max": 140, "step": 5, "unit": "%" },
    "speed": { "type": "number", "label": "Speed", "default": 1, "min": 0.2, "max": 3, "step": 0.1, "unit": "×" },
    "seed": { "type": "number", "label": "Pattern", "default": 3, "min": 1, "max": 99, "step": 1, "help": "Change for a different arrangement." }
  },
  "examples": [
    { "name": "Ice waves", "props": {} },
    { "name": "Ripple", "props": { "mode": "ripple", "dotColor": "#fb923c", "secondColor": "#f43f5e", "accent": "#f97316", "background": "#0c0605", "density": 44 } },
    { "name": "Paper noise", "props": { "mode": "noise", "background": "#f5f0e6", "dotColor": "#1c1917", "gradient": false, "accent": "#f5f0e6", "density": 28, "dotSize": 110, "speed": 0.6 } }
  ],
  "stillAt": 0.5
}
