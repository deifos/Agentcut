    "@remotion/player": "4.0.536",
    "@remotion/shapes": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "@remotion/web-renderer": "4.0.536",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
