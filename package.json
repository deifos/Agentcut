{
  "name": "agentcut-studio",
  "version": "0.2.5",
  "private": true,
  "description": "Agentcut: an open-source video studio you edit by chatting with a coding agent (Claude Code or Codex).",
  "license": "MIT",
  "workspaces": [
    "packages/agentcut"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
